# Optional. Copy to .env (not committed). Only needed for live mode and https (docker-compose.live.yml);
# mock mode needs no .env at all.
# Use both compose files with plain `docker compose up`:
COMPOSE_FILE=docker-compose.yml:docker-compose.live.yml
# Other names the lab answers to (comma separated), such as a local domain that points at 127.0.0.1.
LAB_ALLOWED_HOSTS=lab.local.example
# The certificate and key the lab serves https with; it must cover 127.0.0.1, localhost and LAB_ALLOWED_HOSTS.
P1LAB_TLS_CERT_FILE=/path/to/cert.pem
P1LAB_TLS_KEY_FILE=/path/to/key.pem
